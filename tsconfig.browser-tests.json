{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["playwright.config.ts", "tests/browser/**/*.ts"],
	"exclude": ["tests/browser/**/*.test.ts"]
}
